<ui:FluentWindow x:Class="GlobalAutocorrect.App.Views.FirstRunWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Welcome to Global Autocorrect"
                 Width="640" Height="520" MinWidth="560" MinHeight="480"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.Resources>
        <!-- Step indicator: a numbered dot, with a tick once the step is done. -->
        <DataTemplate x:Key="StepTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="48" Height="2" Margin="10,0" CornerRadius="1" VerticalAlignment="Center"
                        Visibility="{Binding ShowLine, Converter={StaticResource BoolToVisible}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Upcoming">
                                    <Setter Property="Background" Value="{DynamicResource BorderSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <Border Width="28" Height="28" CornerRadius="14" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Upcoming">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                                   Text="{Binding Number}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Upcoming">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ui:SymbolIcon Symbol="Checkmark16" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:SymbolIcon.Style>
                                <Style TargetType="ui:SymbolIcon">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Done">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:SymbolIcon.Style>
                        </ui:SymbolIcon>
                    </Grid>
                </Border>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Title}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextCaption}">
                            <Setter Property="TextWrapping" Value="NoWrap" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Current">
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!-- A point on the first step: icon, title and a line of explanation. -->
        <Style x:Key="PointRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Welcome to Global Autocorrect" ShowMaximize="False" CanMaximize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/GlobalAutocorrect;component/assets/icons/app.ico" Width="16" Height="16" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ItemsControl Grid.Row="1" Margin="0,12,0,0" HorizontalAlignment="Center" ItemsSource="{Binding Steps}"
                      ItemTemplate="{StaticResource StepTemplate}" IsTabStop="False" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- The step scrolls when the window is too short for it (small window, large scale); the buttons stay put (D63). -->
        <ScrollViewer x:Name="StepScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid Margin="48,20,48,8">
                <!-- 1. What it does -->
                <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="What it does" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,24" Text="Welcome to Global Autocorrect. Here's how it helps while you type." />

                    <Grid Style="{StaticResource PointRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="TextGrammarWand24" FontSize="22" />
                        </ContentControl>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource RowTitle}" FontSize="16" Text="Fixes typos as you type" />
                            <TextBlock Style="{StaticResource RowCaption}" FontSize="14" Text="In almost any app, a moment after you stop typing, slips and misspellings are tidied up for you." />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PointRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="ShieldLock24" FontSize="22" />
                        </ContentControl>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource RowTitle}" FontSize="16" Text="Stays on your PC" />
                            <TextBlock Style="{StaticResource RowCaption}" FontSize="14" Text="A local AI does the checking here, so nothing you type ever leaves your computer." />
                        </StackPanel>
                    </Grid>
                    <Grid Style="{StaticResource PointRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl Style="{StaticResource IconBadge}" VerticalAlignment="Top">
                            <ui:SymbolIcon Symbol="KeyboardTab24" FontSize="22" />
                        </ContentControl>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource RowTitle}" FontSize="16" Text="Suggests your next word" />
                            <TextBlock Style="{StaticResource RowCaption}" FontSize="14" Text="A faint suggestion appears as you type. Press Tab to accept it, or carry on to ignore it." />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 2. Download the model -->
                <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Download the model" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"
                               Text="Global Autocorrect needs to download its AI model, about 6 GB. It's saved on this PC and does its thinking here, so your typing stays private. You only need to do this once." />

                    <Border Style="{StaticResource CardBorder}" Padding="20">
                        <Grid>
                            <!-- Ready to download -->
                            <StackPanel Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource IconBadge}">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="22" />
                                    </ContentControl>
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="Ready when you are" />
                                        <TextBlock Style="{StaticResource RowCaption}" Text="Keep this window open until it finishes." />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Download"
                                               Command="{Binding DownloadCommand}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Style="{StaticResource RowCaption}" Margin="0,12,0,0" Text="{Binding Message}"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisible}}" />
                            </StackPanel>

                            <!-- Downloading -->
                            <StackPanel Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisible}}">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{Binding StepName}" />
                                <ProgressBar Margin="0,12,0,8" Height="8" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                             AutomationProperties.Name="Download progress" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Style="{StaticResource TextBody}" Text="{Binding ProgressText}" />
                                    <ui:Button Grid.Column="1" Appearance="Secondary" Content="Cancel" Command="{Binding CancelCommand}" />
                                </Grid>
                            </StackPanel>

                            <!-- Done -->
                            <Grid Visibility="{Binding IsDone, Converter={StaticResource BoolToVisible}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource IconBadge}">
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" FontSize="24" />
                                </ContentControl>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="The model is on this PC" />
                                    <TextBlock Style="{StaticResource RowCaption}" Text="Everything is downloaded. Choose Next to carry on." />
                                </StackPanel>
                            </Grid>

                            <!-- Something went wrong -->
                            <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisible}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ErrorCircle24" FontSize="28" Foreground="{DynamicResource SystemFillColorCriticalBrush}" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="The download didn't finish" />
                                        <TextBlock Style="{StaticResource RowCaption}" FontSize="14" Text="{Binding Message}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="2" Appearance="Primary" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Retry"
                                               Command="{Binding DownloadCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource RowCaption}" Margin="2,14,0,0" FontSize="13"
                               Text="It needs about 6 GB of free space. You can carry on using your PC while it downloads." />
                </StackPanel>

                <!-- 3. You're ready -->
                <StackPanel Visibility="{Binding IsStep3, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Style="{StaticResource PageTitle}" Text="You're ready" />
                    <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,0,0,20"
                               Text="Global Autocorrect now lives in your system tray. These shortcuts are worth knowing." />

                    <Border Style="{StaticResource CardBorder}" Padding="20,8">
                        <ItemsControl ItemsSource="{Binding ShortcutRows}" IsTabStop="False" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ItemsControl ItemsSource="{Binding Keys}" ItemTemplate="{StaticResource KeycapTemplate}"
                                                      IsTabStop="False" Focusable="False" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TextBody}" Text="{Binding Description}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Style="{StaticResource RowCaption}" Margin="2,12,0,0" FontSize="13"
                               Text="You can change these any time: right-click the tray icon and choose Settings." />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="3" Margin="48,8,48,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:Button Grid.Column="0" MinWidth="96" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowLeft24}" Content="Back"
                       Command="{Binding BackCommand}" IsEnabled="{Binding CanGoBack}"
                       Visibility="{Binding IsStep1, Converter={StaticResource BoolToCollapsed}}" />
            <ui:Button Grid.Column="2" MinWidth="110" Appearance="Primary" Content="Next" Command="{Binding NextCommand}"
                       IsEnabled="{Binding CanGoNext}"
                       Visibility="{Binding IsLastStep, Converter={StaticResource BoolToCollapsed}}" />
            <ui:Button Grid.Column="2" MinWidth="110" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Finish"
                       Command="{Binding FinishCommand}"
                       Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisible}}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
