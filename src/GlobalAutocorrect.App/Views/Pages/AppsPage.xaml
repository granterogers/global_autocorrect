<Page x:Class="GlobalAutocorrect.App.Views.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Apps">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32">
            <TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Global Autocorrect never changes what you type in these apps, such as terminals, code editors, password managers and remote desktops." />

            <!-- Add an app -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Leave another app alone" />
                    <TextBlock Style="{StaticResource RowCaption}" Text="Type the program's name as it appears in Task Manager, for example notepad." />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="Program name, for example notepad" Icon="{ui:SymbolIcon AppGeneric24}"
                                    Text="{Binding NewApp, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Program name">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Add"
                                   Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Border>

            <!-- The list -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14,16,6">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="{Binding CountText}" />
                        <ui:Button Grid.Column="1" Appearance="Secondary" Icon="{ui:SymbolIcon ArrowReset24}" Content="Restore defaults"
                                   Command="{Binding RestoreDefaultsCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource RemovableChip}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
