<Page x:Class="GlobalAutocorrect.App.Views.Pages.DictionaryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Dictionary">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,16,32,32">
            <TextBlock Style="{StaticResource PageTitle}" Text="Dictionary" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Words you add here are never changed. Names, slang and technical terms all belong." />

            <!-- Automatic learning -->
            <ui:CardControl Margin="0,0,0,8" Background="{DynamicResource SurfaceCardBrush}" BorderBrush="{DynamicResource BorderSoftBrush}" CornerRadius="8" Icon="{ui:SymbolIcon BookLetter24}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="Learn a word after I type it 3 times" />
                        <TextBlock Style="{StaticResource RowCaption}"
                                   Text="Undoing a correction also adds that word, so it won't be changed again." />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch IsChecked="{Binding AutoLearn, Mode=TwoWay}" AutomationProperties.Name="Learn a word after I type it 3 times" />
            </ui:CardControl>

            <!-- Add a word -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="Add a word" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox PlaceholderText="Type a word" Icon="{ui:SymbolIcon TextEditStyle24}"
                                    Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="New word">
                            <ui:TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                            </ui:TextBox.InputBindings>
                        </ui:TextBox>
                        <ui:Button Grid.Column="1" Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Add"
                                   Command="{Binding AddCommand}" />
                    </Grid>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Error}"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}" />
                </StackPanel>
            </Border>

            <!-- Your words -->
            <Border Style="{StaticResource CardBorder}" Padding="16,14,16,6">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource RowTitle}" Text="{Binding CountText}" />
                        <ui:TextBox Grid.Column="1" PlaceholderText="Search your words" Icon="{ui:SymbolIcon Search24}"
                                    ClearButtonEnabled="True"
                                    Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Search your words" />
                    </Grid>
                    <TextBlock Style="{StaticResource RowCaption}" Margin="0,0,0,12" Text="{Binding EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}" />
                    <ItemsControl ItemsSource="{Binding Words}" ItemTemplate="{StaticResource RemovableChip}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
