<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:views="clr-namespace:GlobalAutocorrect.App.Views">
    <!--
        Shared building blocks for the settings and first-run windows (9.1, 9.2). Built only from the tokens in Tokens.xaml:
        every colour, size and radius is a DynamicResource, so nothing here is a literal and light/dark just works.
        (DynamicResource, not StaticResource, because this file is merged beside Tokens.xaml, not inside it.)
    -->

    <views:BoolToVisibilityConverter x:Key="BoolToVisible" />
    <views:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <views:MillisecondsToSecondsConverter x:Key="MsToSeconds" />

    <!-- Page headings. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,24" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="2,16,0,8" />
    </Style>

    <!-- Text inside a card row: a title and a quieter explanation under it. -->
    <Style x:Key="RowTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="RowCaption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>

    <!-- A soft accent-tinted rounded square that holds an icon. -->
    <Style x:Key="IconBadge" TargetType="ContentControl">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0.14" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A larger, filled variant for the status card and the About header. -->
    <Style x:Key="IconBadgeFilled" TargetType="ContentControl">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border CornerRadius="16" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hero card: a rounded card with a soft accent glow at one corner. -->
    <Style x:Key="HeroCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <LinearGradientBrush x:Key="HeroGlowBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2E1F6FEB" Offset="0" />
        <GradientStop Color="#001F6FEB" Offset="0.7" />
    </LinearGradientBrush>

    <!--
        Settings cards. WPF-UI's CardControl is a button, so each card was a Tab stop with no name that did nothing; the
        switch, list or slider inside it is the control (D63).
    -->
    <Style TargetType="ui:CardControl" BasedOn="{StaticResource {x:Type ui:CardControl}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
    </Style>

    <!-- Pill with a remove button, for the excluded apps and the dictionary. -->
    <Style x:Key="ChipBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="12,2,2,2" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <DataTemplate x:Key="RemovableChip">
        <Border Style="{StaticResource ChipBorder}">
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="{Binding}"
                           FontFamily="{DynamicResource FontFamilyText}" FontSize="{DynamicResource FontSizeBody}"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <ui:Button Margin="6,0,0,0" Padding="6" MinWidth="0" MinHeight="0" BorderThickness="0" CornerRadius="14" Appearance="Transparent"
                           Icon="{ui:SymbolIcon Dismiss12}" ToolTip="Remove"
                           AutomationProperties.Name="{Binding StringFormat='Remove {0}'}"
                           Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                           CommandParameter="{Binding}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Keyboard key look: soft border, thicker bottom edge. -->
    <Style x:Key="KeycapBorder" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBaseBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1,1,1,3" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>
    <Style x:Key="KeycapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyText}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <DataTemplate x:Key="KeycapTemplate">
        <Border Style="{StaticResource KeycapBorder}">
            <TextBlock Style="{StaticResource KeycapText}" Text="{Binding}" />
        </Border>
    </DataTemplate>
</ResourceDictionary>
