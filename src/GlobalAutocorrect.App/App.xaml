<Application x:Class="GlobalAutocorrect.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- WPF-UI 4.x (9.1). ThemeService switches Light/Dark to follow Windows (9.2.d). -->
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
                <!-- Our design tokens (9.2.a-c). -->
                <ResourceDictionary Source="Theme/Tokens.xaml" />
                <!-- Shared styles for the settings and first-run windows (9.1, 9.2). -->
                <ResourceDictionary Source="Theme/Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
